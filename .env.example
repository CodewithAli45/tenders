NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Google Sheets sync (server-only). Use the service-account email, its private
# key with escaped newlines (\n), and the ID from the spreadsheet URL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-spreadsheet-id-from-the-sheet-url
